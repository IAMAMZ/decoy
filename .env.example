# Copy to .env.local (git-ignored). Everything runs in the browser, so these are
# visible in the page: fine on the demo laptop, never deploy a build made with them.
VITE_BOSON_API_KEY=your_key_here
# Optional: a cloned voice id (voice_...) for Margaret; empty uses the default voice
VITE_MARGARET_VOICE=
# Family alert push (free): pick a random topic, e.g. decoy-7f3k2q, and subscribe to it in the ntfy app
VITE_NTFY_TOPIC=
# Optional: real web search on Decoy's screen (free key at tavily.com); empty skips web search
VITE_TAVILY_API_KEY=
